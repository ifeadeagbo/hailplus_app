# Copy to .env and fill in. Never commit .env.
# Values starting with "your_" are treated as unset.

# --- Server -------------------------------------------------------------
NODE_ENV=development            # production on a live server
PORT=5050                       # 5000 clashes with macOS AirPlay Receiver
CLIENT_URL=http://localhost:3000   # storefront URL (CORS + redirects)
SERVER_URL=                     # public API URL, e.g. https://api.yourshop.com (social login callbacks)
TRUST_PROXY=                    # set to 1 when behind a load balancer / reverse proxy
LOG_LEVEL=                      # debug | info | warn | error (default: debug in dev, info in production)
DB_LOGGING=false                # true prints every SQL query

# --- Database (PostgreSQL) ----------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- Auth ---------------------------------------------------------------
# Generate each with: openssl rand -hex 48
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret
JWT_EXPIRE=7d

# --- Stripe (https://dashboard.stripe.com/apikeys) -----------------------
STRIPE_SECRET_KEY=your_stripe_secret_key          # sk_test_... locally, sk_live_... in production
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret  # whsec_... from `stripe listen` or the Dashboard

# --- Email (SMTP) -------------------------------------------------------
STORE_NAME=Your Store Name      # shown in email subjects and footers
SUPPORT_EMAIL=support@yourdomain.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password

# --- Social login (optional: buttons are hidden until these are set) ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# --- Seed script (local development only) -------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
